# ── Barchaysite environment variables ────────────────────────────────────────
# Copy this file to .env and fill in real values before running docker compose.

# ── API ──────────────────────────────────────────────────────────────────────

# Required: secret key for admin endpoints (/admin/items-with-images).
# Generate a strong random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-secure-secret

# Public URL of the API (used in image URLs returned by the API).
# In same-origin mode this is the same as your site domain.
PUBLIC_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins.
# For same-origin mode use the frontend domain.
ALLOWED_ORIGINS=https://yourdomain.com

# ── Frontend ─────────────────────────────────────────────────────────────────

# Leave empty to proxy API via nginx (recommended for single-domain setups).
# Set to an absolute URL if the API is on a separate domain/port.
# Example: API_BASE=https://api.yourdomain.com
API_BASE=

# Host port for the frontend container (default: 80).
# Change to e.g. 8000 if you have a reverse proxy in front.
FRONTEND_PORT=80
